# Env for the self-contained stack (docker-compose.standalone.yml).
#   cp .env.standalone.example .env.standalone  &&  edit the 4 required values
#   docker compose -f docker-compose.standalone.yml --env-file .env.standalone up -d --build

# --- required ---
POSTGRES_PASSWORD=change-me-db-pass
SESSION_SECRET=change-me-session-secret-min-16-chars
SECRET_KEY=REPLACE_WITH_64_HEX          # openssl rand -hex 32
ADMIN_PASSWORD=change-me-admin-pass

# --- optional (defaults shown) ---
ADMIN_USERNAME=admin
PANEL_PORT=8080
# PUBLIC_HOST=vpn.example.com           # default endpoint advertised to clients
# METRICS_TOKEN=                        # set to enable /metrics (Bearer)
# TRUST_PROXY=0                         # =1 only behind a trusted reverse proxy
# LOG_FORMAT=text                       # text|json
# LOG_LEVEL=info                        # debug|info|warn|error
# EMERGENCY_ADMIN_USERNAME=              # break-glass local admin, see docker-compose.standalone.yml
# EMERGENCY_ADMIN_PASSWORD=              # leave both unset normally
