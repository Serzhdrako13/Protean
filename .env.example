# Copy to .env and fill in for the target VPS. Never commit the real .env.

# Existing Postgres container on the VPS -- new database/schema for the panel.
DATABASE_URL=postgres://protean:changeme@postgres:5432/protean?sslmode=disable

# SSH access to the VPS host, used to run wg/awg and edit config files.
# Put the matching private key at ./secrets/id_ed25519 (chmod 600).
# Panel and VPN host on the same machine (the normal case) -> use
# host.docker.internal, not 127.0.0.1 (that would mean "inside the panel
# container", not the VPS host).
#
# MULTI-SERVER: servers are managed in the UI (Servers page); their SSH creds
# are stored encrypted in the DB. SSH_HOST/USER/KEY_PATH below are OPTIONAL and
# used only to auto-seed a "default" server on first run (single-server
# upgrade). Leave SSH_HOST empty to start with no servers and add them in the UI.
SSH_HOST=host.docker.internal
SSH_PORT=22
SSH_USER=protean
# Max seconds for a single remote command (backstops a stuck host). Default 30.
SSH_CMD_TIMEOUT=30

# Set to 1 ONLY if the panel sits behind a trusted reverse proxy, so the
# client IP (rate-limit/audit) is read from X-Forwarded-For. Off by default:
# otherwise the header is attacker-controlled and would let a client forge its
# IP. When off, the real socket address is used.
TRUST_PROXY=0

# Pin the host's SSH public key to prevent MITM (recommended). Get it with:
#   ssh-keyscan -t ed25519 <host>
# and paste the "ssh-ed25519 AAAA..." line here. setup-host.sh fills this in.
# If left empty, the panel trusts the key on first connect and logs it.
SSH_HOST_KEY=
# Alternative to SSH_HOST_KEY: path to an OpenSSH known_hosts file in the container.
SSH_KNOWN_HOSTS=

# Session cookie signing / CSRF-adjacent secret -- any long random string.
SESSION_SECRET=changeme-random-string

# 64 hex chars (32 bytes) -- encrypts peer private keys at rest.
# Generate with: openssl rand -hex 32
SECRET_KEY=changeme-64-hex-chars

# Seeds the first admin user on startup. Only takes effect while the users
# table is empty -- change the password via the DB afterwards if needed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# VPS's public IP/hostname, used as Endpoint in generated client configs.
PUBLIC_HOST=203.0.113.10

# Logging: level (debug|info|warn|error) and format (text|json).
LOG_LEVEL=info
LOG_FORMAT=text

# Prometheus-format metrics at /metrics, guarded by this bearer token.
# Empty = /metrics disabled. Generate: openssl rand -hex 24
# Used by Zabbix HTTP-agent now, and Prometheus/Grafana later.
METRICS_TOKEN=

# Directory holding the self-service portal's "how to connect" content
# (ru.json/en.json/...) -- mount ./vpn-setup-content here (see
# docker-compose.yml) so it can be edited without rebuilding the panel.
# Auto-seeded with working defaults on first boot.
VPN_SETUP_CONTENT_DIR=/data/vpn-setup

# Interfaces to manage. Comma-separated for multi-instance (multisite), e.g.
# WG_INTERFACES=wg0,wg1,wg2. Each becomes its own dashboard/instance with
# independent mesh/egress settings. (Legacy WG_INTERFACE/AWG_INTERFACE still
# work as a single-instance fallback.)
WG_INTERFACES=wg0
AWG_INTERFACES=awg0

# OpenVPN instance (openvpn-server@<instance>). Server is provisioned from the
# panel (Set up OpenVPN server); the panel runs its own tiny CA.
OVPN_INSTANCE=server
OVPN_PORT=1194
OVPN_PROTO=udp
OVPN_SERVER_NET=10.8.0.0
OVPN_SERVER_MASK=255.255.255.0

# IKEv2/strongSwan (provisioned from the panel; panel runs its own CA).
IKEV2_POOL=10.9.0.0/24
IKEV2_DNS=1.1.1.1

# On-host config file paths. Defaults derive from the interface names; override
# if your distro's AmneziaWG packaging puts the file elsewhere.
# WG_CONF_PATH=/etc/wireguard/wg0.conf
# AWG_CONF_PATH=/etc/amnezia/amneziawg/awg0.conf

# Web SSH console (Servers page + a dedicated /console page). Idle/max
# session limits in seconds, concurrency caps; sane defaults, uncomment to
# change. CONSOLE_ALLOWED_ORIGINS only matters behind a reverse proxy that
# fronts the panel under a different origin than the panel process itself
# sees -- comma-separated hostnames, e.g. vpn.example.com.
# CONSOLE_IDLE_TIMEOUT_SECONDS=900
# CONSOLE_MAX_SESSION_SECONDS=28800
# CONSOLE_MAX_PER_USER=5
# CONSOLE_MAX_TOTAL=20
# CONSOLE_ALLOWED_ORIGINS=
