.env
.env.local
.env.standalone
.env.*.local
secrets/*
!secrets/.gitkeep
/panel
/bin/

# Self-service portal's "how to connect" content -- auto-seeded into this
# bind-mounted directory on first container boot (see internal/vpnsetup),
# then meant to be hand-edited on the host; not part of the repo itself.
vpn-setup-content/*
!vpn-setup-content/README.md

# frontend build output -- embedded via internal/web/web.go's go:embed;
# regenerated by `cd frontend && npm run build` (or automatically inside
# the Docker multi-stage build) before `go build ./cmd/panel` will work.
/internal/web/dist/
frontend/node_modules/
frontend/dist/

# local dev/session artifacts, not part of the app
.claude/
claude-resume.last

# editor/OS
.vscode/
.idea/
*.swp
.DS_Store
AGENTS.md
